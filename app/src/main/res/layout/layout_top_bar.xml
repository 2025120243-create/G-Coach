<?xml version="1.0" encoding="utf-8"?>
<!-- Shared top bar: [optional left button]  G-COACH title  [profile avatar].
     BaseActivity.setupTopBar() fills it in, so every screen behaves the same. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topAppBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btnTopLeft"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Menu"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_menu"
        android:visibility="gone"
        app:tint="@color/gc_green" />

    <TextView
        android:id="@+id/tvTopTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="G-COACH"
        android:textColor="@color/gc_green"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar"
        android:clickable="true"
        android:contentDescription="Open profile"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="G"
        android:textColor="@color/gc_green"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
